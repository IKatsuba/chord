    "@zod/zod": "npm:zod@^4.6.5",
    "ansi-escapes": "^7.3.0",
    "chalk": "^6.0.1",
    "cli-truncate": "^6.1.1",
    "convert-layout": "0.11.1",
    "culori": "^4.0.2",
    "diff": "^8.0.4",
