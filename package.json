{
  "name": "@chorded/chord",
  "version": "0.55.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "chord": "bun --define process.env.NODE_ENV:'\"production\"' src/main.tsx",
    "chord:fake": "bun --define process.env.NODE_ENV:'\"production\"' src/main.tsx fake --agent-command \"bun '$PWD/tests/fixtures/fake_agent/main.ts'\"",
    "check": "bun run check:static && bun run test",
    "check:static": "tsc && eslint . && prettier --check . && bun test lint/",
    "test": "bun test --isolate --timeout=60000 ./tests/",
    "fmt": "prettier --write .",
    "lint": "eslint .",
    "compile": "bun scripts/compile.ts",
    "npm": "bun scripts/npm.ts",
    "registry": "bun scripts/registry.ts",
    "mark": "bun scripts/mark.ts",
    "screenshots": "bun scripts/screenshots.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
